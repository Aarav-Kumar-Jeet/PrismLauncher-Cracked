index 0000000000..8a35f53920
--- /dev/null
+++ b/pngsimd.c
@@ -0,0 +1,145 @@
+
+/* pngsimd.c - hardware (cpu/arch) specific code
+ *
+ * Copyright (c) 2018-2024 Cosmin Truta
+ * Copyright (c) 1998-2002,2004,2006-2018 Glenn Randers-Pehrson
